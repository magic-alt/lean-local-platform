[Unit]
Description=LEAN Platform API
After=network.target mysql.service redis.service

[Service]
Type=simple
User=lean-platform
Group=lean-platform
WorkingDirectory=/opt/lean-platform/web/backend
EnvironmentFile=/etc/lean-platform/platform.env
ExecStart=/opt/lean-platform/web/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lean-platform

[Install]
WantedBy=lean-platform.target
