{
  "key": "risk_parity",
  "name": "Risk Parity",
  "description": "Allocate across liquid assets using inverse realized volatility weights.",
  "parameters": [
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "default": "SPY,TLT,GLD"
    },
    {
      "key": "lookback",
      "label": "Volatility Lookback",
      "type": "number",
      "default": 60,
      "min": 10
    },
    {
      "key": "rebalanceDays",
      "label": "Rebalance Days",
      "type": "number",
      "default": 20,
      "min": 1
    },
    {
      "key": "maxWeight",
      "label": "Maximum Weight",
      "type": "number",
      "default": 0.6,
      "min": 0.1,
      "max": 1.0,
      "step": 0.05
    }
  ]
}
