{
  "schemaVersion": 1,
  "description": "Public Research interop surface owned by platform. Research execution/workspace tombstones are intentionally excluded from OpenAPI; qlib-platform owns research computation.",
  "routes": [
    {
      "method": "GET",
      "path": "/api/research/capabilities"
    },
    {
      "method": "GET",
      "path": "/api/research/imports"
    },
    {
      "method": "GET",
      "path": "/api/research/imports/{import_id}"
    },
    {
      "method": "POST",
      "path": "/api/research/imports/qlib"
    },
    {
      "method": "POST",
      "path": "/api/research/runs/{run_id}/lean-validation"
    }
  ]
}
