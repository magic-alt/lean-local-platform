# Windows native production topology. Copy selected values into a private .env.
# All service-owned paths are absolute so Windows SCM working-directory changes
# cannot redirect runtime or market-data writes.
# Full setup and secret-generation instructions: config/deployment/README.md.
LEAN_DEPLOYMENT_MODE=native
LEAN_EXECUTION_BACKEND=native
LEAN_DEPLOYMENT_PROFILE=core

# Platform API and restricted runner use independent random tokens. These are
# local platform credentials, not TuShare/provider tokens.
LEAN_API_AUTH_REQUIRED=1
LEAN_API_TOKEN=<LEAN_API_TOKEN>
LEAN_API_TOKEN_FILE=C:\ProgramData\LeanPlatform\runtime\secrets\api_token
LEAN_RUNNER_TOKEN=<LEAN_RUNNER_TOKEN>
LEAN_RUNNER_TOKEN_FILE=C:\ProgramData\LeanPlatform\runtime\secrets\runner_token

# Deployment hosts require .NET 10 Runtime only. The signed runtime build host
# separately requires .NET 10 SDK and must retain the private signing key.
LEAN_NATIVE_RUNTIME_ID=<PINNED_RUNTIME_ID>
LEAN_NATIVE_RUNTIME_ROOT=C:\ProgramData\LeanPlatform\lean
LEAN_DOTNET_PATH=C:\Program Files\dotnet\dotnet.exe
LEAN_NATIVE_SANDBOX=required
LEAN_RUNNER_URL=http://127.0.0.1:8010
LEAN_DATA_DIR=D:\LeanPlatform\data
LEAN_RUNTIME_DIR=C:\ProgramData\LeanPlatform\runtime
LEAN_PARQUET_DIR=D:\LeanPlatform\data\output\parquet

# Raw passwords are consumed by database/bootstrap tooling. Passwords embedded
# in connection URLs must be percent-encoded. Use one unique secret per identity.
LEAN_POSTGRES_ADMIN_PASSWORD=<RAW_POSTGRES_ADMIN_PASSWORD>
LEAN_POSTGRES_APP_PASSWORD=<RAW_POSTGRES_APP_PASSWORD>
LEAN_POSTGRES_CELERY_PASSWORD=<RAW_POSTGRES_CELERY_PASSWORD>
LEAN_POSTGRES_MLFLOW_PASSWORD=<RAW_POSTGRES_MLFLOW_PASSWORD>
LEAN_RABBITMQ_PASSWORD=<RAW_RABBITMQ_PASSWORD>
LEAN_POSTGRES_ADMIN_URL=postgresql://postgres:<URL_ENCODED_POSTGRES_ADMIN_PASSWORD>@127.0.0.1:5432/postgres
LEAN_DATABASE_URL=postgresql+psycopg://lean_app:<URL_ENCODED_POSTGRES_APP_PASSWORD>@127.0.0.1:5432/lean_platform
CELERY_BROKER_URL=amqp://lean_worker:<URL_ENCODED_RABBITMQ_PASSWORD>@127.0.0.1:5672/lean
CELERY_RESULT_BACKEND=db+postgresql+psycopg://lean_celery:<URL_ENCODED_POSTGRES_CELERY_PASSWORD>@127.0.0.1:5432/lean_celery
LEAN_MLFLOW_DATABASE_URL=postgresql+psycopg://lean_mlflow:<URL_ENCODED_POSTGRES_MLFLOW_PASSWORD>@127.0.0.1:5432/lean_mlflow
CLICKHOUSE_ENABLED=0

# Windows production-only gates and service identities.
LEAN_WINDOWS_PRODUCTION_MODE=0
LEAN_WINDOWS_SANDBOX_POLICY_FILE=C:\ProgramData\LeanPlatform\sandbox-policy.json
LEAN_WINDOWS_PLATFORM_ACCOUNT=.\LeanPlatform
LEAN_WINDOWS_PLATFORM_PASSWORD=<WINDOWS_PLATFORM_SERVICE_PASSWORD>
LEAN_WINDOWS_RUNNER_ACCOUNT=.\LeanRunner
LEAN_WINDOWS_RUNNER_PASSWORD=<WINDOWS_RUNNER_SERVICE_PASSWORD>
