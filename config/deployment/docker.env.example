# Docker remains a first-class, legacy-compatible deployment.
LEAN_DEPLOYMENT_MODE=docker
LEAN_EXECUTION_BACKEND=docker
LEAN_DEPLOYMENT_PROFILE=full
LEAN_RUNNER_URL=http://lean-runner:8010
LEAN_MYSQL_USER=<MYSQL_USER>
LEAN_MYSQL_PASSWORD=<MYSQL_PASSWORD>
LEAN_MYSQL_ROOT_PASSWORD=<MYSQL_ROOT_PASSWORD>
LEAN_REDIS_PASSWORD=<REDIS_PASSWORD>
