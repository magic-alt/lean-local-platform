{
  "name": "lean-local-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "NODE_PATH=./node_modules playwright test --project=chromium",
    "test:e2e:headed": "NODE_PATH=./node_modules playwright test --project=chromium --headed",
    "test:e2e:debug": "NODE_PATH=./node_modules PWDEBUG=1 playwright test --project=chromium --debug",
    "test:e2e:report": "NODE_PATH=./node_modules playwright show-report ../../tests/e2e/reports/html",
    "test:e2e:smoke": "NODE_PATH=./node_modules playwright test --project=chromium --grep @smoke",
    "test:e2e:backtest": "NODE_PATH=./node_modules playwright test --project=chromium --grep @backtest",
    "test:e2e:compat": "NODE_PATH=./node_modules playwright test --project=chromium-1280 --project=tablet --project=mobile",
    "test:e2e:ui-audit": "E2E_UI_ONLY=1 NODE_PATH=./node_modules playwright test 15-ui-audit.spec.ts --project=chromium-1280 --project=tablet --project=mobile",
    "docs:screenshots": "UPDATE_DOC_SCREENSHOTS=1 NODE_PATH=./node_modules playwright test 11-docs-screenshots.spec.ts --project=chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.0.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.2",
    "github-slugger": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
