# Complete environment template.
#
# 1. Copy this file to D:\Project\platform\.env (Windows) or <repo>/.env.
# 2. Select the matching topology in config/deployment/*.env.example.
# 3. Replace every required placeholder; never commit, paste, log, or screenshot
#    the resulting .env file.
# 4. See config/deployment/README.md for required variables, password generation,
#    URL encoding, account provisioning, startup, and verification.
#
# Provider credentials below are OPTIONAL unless that provider is enabled.
TUSHARE_TOKEN=your_tushare_pro_token
TICKFLOW_API_KEY=your_tickflow_api_key
JQDATA_USERNAME=your_jqdata_username
JQDATA_PASSWORD=your_jqdata_password
# Optional alternative to username/password when available.
JQDATA_TOKEN=your_jqdata_token
RQDATA_USERNAME=your_rqdata_username
RQDATA_PASSWORD=your_rqdata_password
ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key
FINNHUB_API_KEY=your_finnhub_api_key
LONGBRIDGE_APP_KEY=your_longbridge_app_key
LONGBRIDGE_APP_SECRET=your_longbridge_app_secret
LONGBRIDGE_ACCESS_TOKEN=your_longbridge_access_token
LONGBRIDGE_OAUTH_CLIENT_ID=your_longbridge_oauth_client_id
# Example entitlement window; replace it with the actual range for the account.
# Dates outside the configured window fall back to AKShare.
JQDATA_DATA_RANGE_START=2025-03-29
JQDATA_DATA_RANGE_END=2026-04-05

# PostgreSQL and RabbitMQ credentials.
# Compose requires the five raw password variables. Native deployment also
# requires LEAN_POSTGRES_ADMIN_URL while initializing roles/databases. Use a
# unique value for every account. *_PASSWORD values are raw; passwords embedded
# in URLs must be percent-encoded. Hex-only generated passwords are URL-safe.
LEAN_POSTGRES_ADMIN_PASSWORD=
LEAN_POSTGRES_APP_PASSWORD=
LEAN_POSTGRES_CELERY_PASSWORD=
LEAN_POSTGRES_MLFLOW_PASSWORD=
LEAN_RABBITMQ_PASSWORD=
LEAN_POSTGRES_ADMIN_URL=postgresql://postgres:YOUR_URL_ENCODED_ADMIN_PASSWORD@127.0.0.1:5432/postgres
LEAN_DATABASE_URL=postgresql+psycopg://lean_app:YOUR_URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/lean_platform
CELERY_BROKER_URL=amqp://lean_worker:YOUR_URL_ENCODED_RABBITMQ_PASSWORD@127.0.0.1:5672/lean
CELERY_RESULT_BACKEND=db+postgresql+psycopg://lean_celery:YOUR_URL_ENCODED_CELERY_PASSWORD@127.0.0.1:5432/lean_celery
LEAN_MLFLOW_DATABASE_URL=postgresql+psycopg://lean_mlflow:YOUR_URL_ENCODED_MLFLOW_PASSWORD@127.0.0.1:5432/lean_mlflow
LEAN_TUSHARE_CALLS_PER_MINUTE=500
LEAN_TUSHARE_FETCH_CONCURRENCY=16
# Market time-series writes to PostgreSQL are prohibited. Provider facts remain
# in Parquet and are queried through DuckDB.
LEAN_TUSHARE_TYPED_SOURCE_WRITES=0
LEAN_DAILY_BASIC_FETCH_CONCURRENCY=32
LEAN_DIVIDEND_FETCH_CONCURRENCY=32
LEAN_STK_LIMIT_FETCH_CONCURRENCY=16
LEAN_SUSPEND_FETCH_CONCURRENCY=16
LEAN_DATA_SYNC_BATCH_UNITS=16
LEAN_DATA_SYNC_CHUNK_ROWS=100000
LEAN_DATA_SYNC_TASK_SOFT_LIMIT_SECONDS=1200
LEAN_DATA_AUTO_UPDATE=1
LEAN_DATA_AUTO_CHECK_SECONDS=300
LEAN_DATA_EXTENDED_SYMBOLS_PER_RUN=200
LEAN_DATA_EXTENDED_SYMBOL_REFRESH_DAYS=30
LEAN_DATA_SYNC_LOOKBACK_TRADING_DAYS=5
LEAN_DATA_SYNC_CATCHUP_TRADING_DAYS=60
LEAN_DAILY_SYNC_BATCH_UNITS=16
LEAN_DAILY_SYNC_CHUNK_ROWS=100000
LEAN_DAILY_INCREMENT_BATCH_DATES=16
LEAN_TUSHARE_LINEAGE_ASYNC=1
LEAN_RAW_ARCHIVE_GZIP_LEVEL=1
LEAN_TUSHARE_HK_CALLS_PER_HOUR=1
LEAN_POSTGRES_CPUS=4.0
LEAN_POSTGRES_MEMORY=6g
# Full-stack initial synchronization should run with at least 16 GiB assigned
# to Docker Desktop. The launcher warns below this host-wide budget.
LEAN_DOCKER_MIN_MEMORY_GB=16
LEAN_POSTGRES_CONNECT_ATTEMPTS=5
LEAN_POSTGRES_CONNECT_RETRY_DELAY_SECONDS=0.5
LEAN_POSTGRES_POOL_MIN_SIZE=1
LEAN_POSTGRES_POOL_MAX_SIZE=10
LEAN_DOCKER_BUILD_CACHE_MAX=2GB
# Deployment orchestration and LEAN execution are independent choices.
LEAN_DEPLOYMENT_MODE=docker
LEAN_EXECUTION_BACKEND=docker
LEAN_DEPLOYMENT_PROFILE=full
# Native production uses a pinned signed runtime and fails closed without bwrap.
LEAN_NATIVE_RUNTIME_ID=
LEAN_NATIVE_RUNTIME_ROOT=./web/runtime/lean
# Optional when dotnet is not on PATH. Windows also checks the standard path.
LEAN_DOTNET_PATH=
LEAN_NATIVE_SANDBOX=required
# Windows native production additionally requires a current host-bound
# certification issued from real broker/database/fault/soak evidence.
LEAN_WINDOWS_PRODUCTION_MODE=0
LEAN_RESEARCH_BACKEND=docker
LEAN_RUNNER_URL=
# Backtest containers accept only digest-pinned images on this comma-separated allowlist.
# The configured LEAN_DOCKER_IMAGE is always included.
LEAN_ALLOWED_DOCKER_IMAGES=
LEAN_RESEARCH_IMAGE=quantconnect/research@sha256:1548cafe8d696c1a30774413fc6f7c0d7f0205104f2f78110d9a84906ac65634
LEAN_ALLOWED_RESEARCH_IMAGES=
LEAN_API_AUTH_REQUIRED=1
# Platform API credential; this is NOT a TuShare or other provider token.
LEAN_API_TOKEN=
# The start script writes a 0600 token here; Compose can recover auth from it.
LEAN_API_TOKEN_FILE=web/runtime/secrets/api_token
# Restricted LEAN runner authentication uses a different credential.
LEAN_RUNNER_TOKEN=
LEAN_RUNNER_TOKEN_FILE=web/runtime/secrets/runner_token
LEAN_BACKTEST_EXECUTION_DELEGATED=0
LEAN_DOCKER_NETWORK=none
LEAN_DOCKER_CPUS=2
LEAN_DOCKER_MEMORY=4g
LEAN_DOCKER_PIDS_LIMIT=512
LEAN_DOCKER_READ_ONLY=1
LEAN_RESEARCH_CPUS=2
LEAN_RESEARCH_MEMORY=4g
LEAN_RESEARCH_PIDS_LIMIT=512
LEAN_DATA_DIR=./data
LEAN_MARKET_DATA_DIR=./data
LEAN_PARQUET_DIR=./data/output/parquet
LEAN_OBJECT_STORE_MODE=filesystem
LEAN_FILE_OBJECT_STORE_DIR=./data/object-store
# Bound derived Parquet work so API and control-plane services remain responsive.
LEAN_PARQUET_MAX_THREADS=4
LEAN_PARQUET_PARTITION_ROWS=100000
LEAN_DATA_DEMAND_WORKER_CPUS=4.0
# Host-visible paths shown by the on-demand download picker.
# LEAN_HOST_DATA_DIR=/Volumes/MarketData/lean-platform/data
# LEAN_HOST_PARQUET_DIR=/Volumes/MarketData/lean-platform/data/output/parquet
# Optional additional container-mounted export roots, separated by ':' on macOS/Linux.
# LEAN_ON_DEMAND_EXPORT_ROOTS=/workspace/Data/nas:/workspace/Data/external
LEAN_DB_OBJECT_STORE_ENABLED=1
LEAN_DB_OBJECT_CHUNK_BYTES=1048576

# Optional A-share Technology structured Insights. Configure any number of providers;
# the UI exposes every configured provider/model and the published production profile
# controls the scheduled run. This environment selection remains the legacy fallback.
LEAN_INSIGHTS_LLM_PROVIDER=
# API keys are environment-only and are never stored in PostgreSQL.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional legacy default override. DeepSeek exposes both deepseek-v4-flash and
# deepseek-v4-pro through the same DEEPSEEK_API_KEY; select either in the UI.
# Other defaults: zhipu=glm-5.2, kimi=kimi-k2.6,
# openai=gpt-5-mini, anthropic=claude-sonnet-4-6.
# The base URL must expose an OpenAI-compatible /chat/completions endpoint.
LEAN_INSIGHTS_LLM_BASE_URL=
LEAN_INSIGHTS_LLM_MODEL=
LEAN_INSIGHTS_LLM_TIMEOUT_SECONDS=60

# A-share technology report uses the configured Insights model as an auditable
# six-role advisory pipeline. API keys remain environment-only.
LEAN_ASHARE_TECH_AGENT_MODE=hybrid_multi_agent
LEAN_ASHARE_TECH_EVALUATION_HOUR=18
LEAN_ASHARE_TECH_EVALUATION_MINUTE=45
LEAN_ASHARE_TECH_REPORT_HOUR=17
LEAN_ASHARE_TECH_REPORT_MINUTE=30
LEAN_PAPER_WALKFORWARD_HOUR=18
LEAN_PAPER_WALKFORWARD_MINUTE=45
LEAN_DERIVED_MAINTENANCE_HOUR=19
LEAN_DERIVED_MAINTENANCE_MINUTE=30
LEAN_PAPER_ORDER_PIPELINE_V2_ENABLED=1
LEAN_SCHEDULED_AUTOMATION_ENABLED=1
LEAN_POSTGRES_BACKUP_HOUR=3
LEAN_POSTGRES_BACKUP_MINUTE=0
LEAN_POSTGRES_BACKUP_RETENTION_DAYS=7
LEAN_POSTGRES_BACKUP_MAX_FILES=14
# Optional operator-owned notification endpoint. Critical alerts are delivered
# by default; repeated Paper scheduling warnings escalate after three events.
# See docs/operations/feishu-webhook-relay.md for Pipedream/Make -> Feishu.
LEAN_ALERT_WEBHOOK_URL=
LEAN_ALERT_WEBHOOK_BEARER_TOKEN=
# Optional independent on-call/escalation endpoint. Critical events are sent
# here even when the primary notification channel is disabled.
LEAN_ALERT_ESCALATION_WEBHOOK_URL=
LEAN_ALERT_ESCALATION_WEBHOOK_BEARER_TOKEN=
LEAN_ALERT_MIN_SEVERITY=error
LEAN_ALERT_ESCALATE_AFTER=3
LEAN_ALERT_ESCALATION_AFTER=1
LEAN_ALERT_COOLDOWN_SECONDS=900
LEAN_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
# Periodic resource-pressure thresholds. Disk/memory/CPU are percentages;
# queue values are the maximum pending depth of a single Celery queue.
LEAN_RESOURCE_DISK_WARNING=75
LEAN_RESOURCE_DISK_CRITICAL=85
LEAN_RESOURCE_MEMORY_WARNING=80
LEAN_RESOURCE_MEMORY_CRITICAL=90
LEAN_RESOURCE_CPU_WARNING=85
LEAN_RESOURCE_CPU_CRITICAL=95
LEAN_RESOURCE_QUEUE_WARNING=20
LEAN_RESOURCE_QUEUE_CRITICAL=50
# Optional colon-separated paths; defaults to the configured run/data roots.
LEAN_RESOURCE_MONITOR_PATHS=
# Isolated acceptance only. When enabled, a worker pauses after the selected
# immutable Paper checkpoints so a fault runner can restart a dependency.
LEAN_FAULT_INJECTION_ENABLED=0
LEAN_PAPER_CHECKPOINT_PAUSE_SECONDS=0
LEAN_PAPER_FAULT_PAUSE_PHASES=intent_capture,constraint_validation,matching,ledger,snapshot_report,reconciliation
# Optional comma-separated YYYY-MM-DD:phase targets. When set, only those
# exact checkpoints pause; this avoids slowing every phase of every Paper day.
LEAN_PAPER_FAULT_PAUSE_TARGETS=
# Periodic durable-finalization recovery after a worker is lost mid-checkpoint.
LEAN_PAPER_FINALIZE_STALE_SECONDS=120
LEAN_ASHARE_TECH_RETRY_MINUTES=30
LEAN_ASHARE_TECH_CLOSE_TOLERANCE_PCT=0.15
