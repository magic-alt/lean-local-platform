# Copy this file to .env and fill local secrets. Do not commit .env.
TUSHARE_TOKEN=your_tushare_pro_token
TICKFLOW_API_KEY=your_tickflow_api_key
JQDATA_USERNAME=your_jqdata_username
JQDATA_PASSWORD=your_jqdata_password
# Optional alternative to username/password when available.
JQDATA_TOKEN=your_jqdata_token
RQDATA_USERNAME=your_rqdata_username
RQDATA_PASSWORD=your_rqdata_password
ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key
FINNHUB_API_KEY=your_finnhub_api_key
LONGBRIDGE_APP_KEY=your_longbridge_app_key
LONGBRIDGE_APP_SECRET=your_longbridge_app_secret
LONGBRIDGE_ACCESS_TOKEN=your_longbridge_access_token
LONGBRIDGE_OAUTH_CLIENT_ID=your_longbridge_oauth_client_id
# Current account entitlement window. Dates outside this window fall back to AKShare.
JQDATA_DATA_RANGE_START=2025-03-29
JQDATA_DATA_RANGE_END=2026-04-05

# MySQL is the runtime database. DuckDB reads Parquet exports and does not replace MySQL.
LEAN_DATABASE_URL=mysql+pymysql://lean:lean@127.0.0.1:3306/lean_market
# Generated by scripts/start_web_single_instance.sh for the restricted bulk loader.
# LEAN_MYSQL_LOADER_PASSWORD=
LEAN_TUSHARE_CALLS_PER_MINUTE=500
LEAN_TUSHARE_FETCH_CONCURRENCY=16
LEAN_STK_LIMIT_FETCH_CONCURRENCY=16
LEAN_SUSPEND_FETCH_CONCURRENCY=16
LEAN_DATA_SYNC_BATCH_UNITS=32
LEAN_DATA_SYNC_CHUNK_ROWS=250000
LEAN_DAILY_SYNC_BATCH_UNITS=64
LEAN_DAILY_SYNC_CHUNK_ROWS=500000
LEAN_RAW_ARCHIVE_GZIP_LEVEL=1
LEAN_TUSHARE_HK_CALLS_PER_HOUR=1
LEAN_MYSQL_BUFFER_POOL_SIZE=1G
LEAN_MYSQL_REDO_LOG_CAPACITY=256M
# Only limits MySQL writes made by on-demand fetches. One-click bulk sync is
# limited by the physical disk reserve instead of this cache ceiling.
LEAN_MYSQL_ON_DEMAND_MAX_DATABASE_GB=50
LEAN_MYSQL_CONNECT_ATTEMPTS=5
LEAN_MYSQL_CONNECT_RETRY_DELAY_SECONDS=0.5
LEAN_MYSQL_BINLOG_EXPIRE_SECONDS=604800
LEAN_DOCKER_BUILD_CACHE_MAX=2GB
# Backtest containers accept only digest-pinned images on this comma-separated allowlist.
# The configured LEAN_DOCKER_IMAGE is always included.
LEAN_ALLOWED_DOCKER_IMAGES=
LEAN_RESEARCH_IMAGE=quantconnect/research@sha256:1548cafe8d696c1a30774413fc6f7c0d7f0205104f2f78110d9a84906ac65634
LEAN_ALLOWED_RESEARCH_IMAGES=
LEAN_API_AUTH_REQUIRED=1
LEAN_API_TOKEN=
LEAN_BACKTEST_EXECUTION_DELEGATED=0
LEAN_DOCKER_NETWORK=none
LEAN_DOCKER_CPUS=2
LEAN_DOCKER_MEMORY=4g
LEAN_DOCKER_PIDS_LIMIT=512
LEAN_DOCKER_READ_ONLY=1
LEAN_RESEARCH_CPUS=2
LEAN_RESEARCH_MEMORY=4g
LEAN_RESEARCH_PIDS_LIMIT=512
# Set an absolute directory after copying the stopped MySQL volume to a
# mechanical drive. Blank keeps the local named volume.
# LEAN_MYSQL_DATA_DIR=/Volumes/MarketData/lean-platform/mysql
LEAN_PARQUET_DIR=../Data/parquet
# Host-visible paths shown by the on-demand download picker.
# LEAN_HOST_DATA_DIR=/Volumes/MarketData/lean-data
# LEAN_HOST_PARQUET_DIR=/Volumes/MarketData/lean-data/parquet
# Optional additional container-mounted export roots, separated by ':' on macOS/Linux.
# LEAN_ON_DEMAND_EXPORT_ROOTS=/workspace/Data/nas:/workspace/Data/external
LEAN_DB_OBJECT_STORE_ENABLED=1
LEAN_DB_OBJECT_CHUNK_BYTES=1048576

# Optional structured Insights. Fill one API key and the provider is detected automatically.
# If multiple keys are configured, select one of: deepseek, zhipu, kimi, openai, anthropic.
# When left blank, the first configured key in the order below is used.
LEAN_INSIGHTS_LLM_PROVIDER=
# API keys are environment-only and are never stored in MySQL.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides. Leave blank to use the selected provider's defaults:
# deepseek=deepseek-v4-flash, zhipu=glm-5.2, kimi=kimi-k2.6,
# openai=gpt-5-mini, anthropic=claude-sonnet-4-6.
# The base URL must expose an OpenAI-compatible /chat/completions endpoint.
LEAN_INSIGHTS_LLM_BASE_URL=
LEAN_INSIGHTS_LLM_MODEL=
LEAN_INSIGHTS_LLM_TIMEOUT_SECONDS=60
LEAN_ASHARE_TECH_REPORT_HOUR=17
LEAN_ASHARE_TECH_REPORT_MINUTE=30
LEAN_PAPER_WALKFORWARD_HOUR=18
LEAN_PAPER_WALKFORWARD_MINUTE=45
LEAN_ASHARE_TECH_RETRY_MINUTES=30
LEAN_ASHARE_TECH_CLOSE_TOLERANCE_PCT=0.15
